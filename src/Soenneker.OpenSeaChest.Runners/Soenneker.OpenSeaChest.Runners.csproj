<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsAotCompatible>true</IsAotCompatible>
        <Nullable>enable</Nullable>
        <Platforms>AnyCPU</Platforms>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <Description>Updates packaged native openSeaChest binaries from official releases.</Description>
        <Version Condition="'$(BUILD_VERSION)' == ''">4.0.0</Version>
        <Version Condition="'$(BUILD_VERSION)' != ''">$(BUILD_VERSION)</Version>
        <AssemblyName>Soenneker.OpenSeaChest.Runners</AssemblyName>
        <Copyright>Copyright © 2026 Jake Soenneker</Copyright>
        <Authors>Jake Soenneker</Authors>
        <Company>https://soenneker.com</Company>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IsPackable>false</IsPackable>
        <LangVersion>latest</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Soenneker.Extensions.LoggerConfiguration" Version="4.0.1442" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
        <PackageReference Include="Soenneker.Managers.Runners" Version="4.0.2646" />
        <PackageReference Include="Soenneker.GitHub.Repositories.Releases" Version="4.0.1101" />
        <PackageReference Include="Soenneker.Utils.File.Download" Version="4.0.1820" />
        <PackageReference Include="Soenneker.Utils.File" Version="4.0.2319" />
        <PackageReference Include="Soenneker.Utils.Directory" Version="4.0.967" />
        <PackageReference Include="Soenneker.Compression.Tar.XZ" Version="4.0.440" />
    </ItemGroup>
</Project>

