<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <IsAotCompatible>true</IsAotCompatible>
        <Nullable>enable</Nullable>
        <Platforms>AnyCPU</Platforms>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <Description>Updates packaged native openSeaChest binaries from official releases.</Description>
        <Version Condition="'$(BUILD_VERSION)' == ''">11.0.0</Version>
        <Version Condition="'$(BUILD_VERSION)' != ''">$(BUILD_VERSION)</Version>
        <AssemblyName>Soenneker.OpenSeaChest.Runners</AssemblyName>
        <Copyright>Copyright © 2026 Jake Soenneker</Copyright>
        <Authors>Jake Soenneker</Authors>
        <Company>https://soenneker.com</Company>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IsPackable>false</IsPackable>
        <LangVersion>latest</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Soenneker.Extensions.LoggerConfiguration" Version="11.0.1447" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0-rc.3.26522.148" />
        <PackageReference Include="Soenneker.Managers.Runners" Version="11.0.2653" />
        <PackageReference Include="Soenneker.GitHub.Repositories.Releases" Version="11.0.1104" />
        <PackageReference Include="Soenneker.Utils.File.Download" Version="11.0.1828" />
        <PackageReference Include="Soenneker.Utils.File" Version="11.0.2326" />
        <PackageReference Include="Soenneker.Utils.Directory" Version="11.0.970" />
        <PackageReference Include="Soenneker.Compression.Tar.XZ" Version="11.0.446" />
    </ItemGroup>
</Project>

